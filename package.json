{
  "name": "okproof",
  "version": "0.2.0",
  "description": "Prove agent-written pull requests against their acceptance criteria. Works with Playwright Test or any runner that writes JUnit XML.",
  "license": "Apache-2.0",
  "author": "Rudra Kumar Pandey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudr19/okproof.git"
  },
  "homepage": "https://github.com/rudr19/okproof#readme",
  "bugs": {
    "url": "https://github.com/rudr19/okproof/issues"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "okproof": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "TRADEMARK.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "test": "npm run build && node scripts/test.mjs",
    "check": "node dist/src/cli.js check",
    "demo": "npm run build && node examples/demo/run-demo.mjs",
    "smoke": "node scripts/pack-smoke.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "fast-check": "3.23.2",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./driver": {
      "types": "./dist/src/driver/index.d.ts",
      "default": "./dist/src/driver/index.js"
    },
    "./playwright": {
      "types": "./dist/src/playwright.d.ts",
      "default": "./dist/src/playwright.js"
    },
    "./verify": {
      "types": "./dist/src/verify/index.d.ts",
      "default": "./dist/src/verify/index.js"
    }
  },
  "keywords": [
    "testing",
    "acceptance-criteria",
    "playwright",
    "junit",
    "ai-agents",
    "pull-request"
  ],
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.0.0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
