{
  "name": "okayd",
  "version": "0.0.1",
  "description": "Prove agent-written pull requests against their acceptance criteria. Works with Playwright Test or any runner that writes JUnit XML.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "okayd": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "test": "npm run build && node scripts/test.mjs",
    "check": "node dist/src/cli.js check"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "22.10.2"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./driver": {
      "types": "./dist/src/driver/index.d.ts",
      "default": "./dist/src/driver/index.js"
    },
    "./playwright": {
      "types": "./dist/src/playwright.d.ts",
      "default": "./dist/src/playwright.js"
    },
    "./verify": {
      "types": "./dist/src/verify/index.d.ts",
      "default": "./dist/src/verify/index.js"
    }
  },
  "keywords": [
    "testing",
    "acceptance-criteria",
    "playwright",
    "junit",
    "ai-agents",
    "pull-request"
  ],
  "peerDependencies": {
    "@anthropic-ai/sdk": "*"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  }
}
